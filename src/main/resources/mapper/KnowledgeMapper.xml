<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erupt.repository.mapper.KnowledgeMapper">

    <resultMap id="BaseResultMap" type="com.example.erupt.repository.entity.Knowledge">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="knowledge_name" property="knowledgeName" jdbcType="VARCHAR"/>
        <result column="knowledge_content" property="knowledgeContent" jdbcType="LONGVARCHAR"/>
        <result column="knowledge_type" property="knowledgeType" jdbcType="VARCHAR"/>
        <result column="create_user_id" property="createUserId" jdbcType="BIGINT"/>
        <result column="update_user_id" property="updateUserId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--
      列表字段。注意：当前包含 knowledge_content 大字段（正文随列表一起返回），
      数据量小时方便前端直接展示与检索；数据量大时应从该片段中剥离 knowledge_content，
      仅在详情接口返回，避免列表查询传输与内存开销。
    -->
    <sql id="List_Column_List">
        id, knowledge_name, knowledge_content, knowledge_type, create_user_id, update_user_id, create_time, update_time
    </sql>

    <sql id="Base_Column_List">
        id, knowledge_name, knowledge_content, knowledge_type, create_user_id, update_user_id, create_time, update_time
    </sql>

    <sql id="Condition_Where">
        <where>
            <if test="type != null and type != ''">
                AND knowledge_type = #{type}
            </if>
            <!--
              标题 + 正文（mediumtext）模糊匹配。ESCAPE '/' 配合服务层 LikeEscape，
              避免用户输入的 %、_ 被当作通配符。
              注意：LIKE '%keyword%' 对 mediumtext 无法使用普通索引，会走全表扫描；
              当前 t_knowledge 数据量小（13 行）无影响，数据量增长后建议改为
              FULLTEXT 索引 + MATCH(...) AGAINST(...)，或接入 Elasticsearch。
            -->
            <if test="keyword != null and keyword != ''">
                AND (knowledge_name LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/'
                OR knowledge_content LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/')
            </if>
        </where>
    </sql>

    <!--
      全文检索条件：依赖 t_knowledge 上的全文索引 ft_knowledge_search（ngram 解析器）。
      相比 LIKE '%kw%' 可利用索引、避免 mediumtext 全表扫描；
      但受 ngram_token_size=2 限制，单字/单词无法命中，这类关键词由服务层降级回 LIKE。
    -->
    <sql id="Condition_Where_FullText">
        <where>
            <if test="type != null and type != ''">
                AND knowledge_type = #{type}
            </if>
            <if test="keyword != null and keyword != ''">
                AND MATCH(knowledge_name, knowledge_content) AGAINST(#{keyword} IN BOOLEAN MODE)
            </if>
        </where>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id"
            parameterType="com.example.erupt.repository.entity.Knowledge">
        INSERT INTO t_knowledge (knowledge_name, knowledge_content, knowledge_type, create_time, update_time)
        VALUES (#{knowledgeName}, #{knowledgeContent}, #{knowledgeType}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_knowledge
        WHERE id = #{id}
    </select>

    <select id="selectByTypeAndName" resultMap="BaseResultMap">
        SELECT
        <include refid="List_Column_List"/>
        FROM t_knowledge
        WHERE knowledge_type = #{type}
          AND knowledge_name = #{name}
        LIMIT 1
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="List_Column_List"/>
        FROM t_knowledge
        <include refid="Condition_Where"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM t_knowledge
        <include refid="Condition_Where"/>
    </select>

    <select id="selectByConditionFullText" resultMap="BaseResultMap">
        SELECT
        <include refid="List_Column_List"/>
        FROM t_knowledge
        <include refid="Condition_Where_FullText"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByConditionFullText" resultType="long">
        SELECT COUNT(*)
        FROM t_knowledge
        <include refid="Condition_Where_FullText"/>
    </select>

    <update id="updateById" parameterType="com.example.erupt.repository.entity.Knowledge">
        UPDATE t_knowledge
        <set>
            <if test="knowledgeName != null">knowledge_name = #{knowledgeName},</if>
            <if test="knowledgeContent != null">knowledge_content = #{knowledgeContent},</if>
            <if test="knowledgeType != null">knowledge_type = #{knowledgeType},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM t_knowledge
        WHERE id = #{id}
    </delete>

    <!-- 批量删除：ids 由服务层保证非空且已去重 -->
    <delete id="deleteByIds">
        DELETE FROM t_knowledge
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countByIds" resultType="long">
        SELECT COUNT(*)
        FROM t_knowledge
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 类型去重：SQL 层 DISTINCT + 剔除空值，应用层再做 trim 后二次去重 -->
    <select id="selectDistinctTypes" resultType="java.lang.String">
        SELECT DISTINCT TRIM(knowledge_type) AS knowledge_type
        FROM t_knowledge
        WHERE knowledge_type IS NOT NULL
          AND TRIM(knowledge_type) != ''
        ORDER BY knowledge_type
    </select>
</mapper>
