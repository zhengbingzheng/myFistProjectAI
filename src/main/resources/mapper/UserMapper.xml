<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erupt.repository.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.erupt.repository.entity.User">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="last_login_time" property="lastLoginTime" jdbcType="TIMESTAMP"/>
        <result column="del_flag" property="delFlag" jdbcType="CHAR"/>
        <result column="delete_by" property="deleteBy" jdbcType="VARCHAR"/>
        <result column="delete_time" property="deleteTime" jdbcType="TIMESTAMP"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, nickname, avatar, email, phone, status, remark, last_login_time,
        del_flag, delete_by, delete_time, create_by, update_by, create_time, update_time
    </sql>

    <sql id="Condition_Where">
        <!-- 仅查询未删除记录：软删除后所有列表/详情/查重都应排除已删除数据 -->
        del_flag = '0'
        <if test="status != null">
            AND status = #{status}
        </if>
        <!-- ESCAPE '/' 配合服务层 LikeEscape，避免用户输入的 %、_ 被当作通配符 -->
        <if test="keyword != null and keyword != ''">
            AND (username LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/'
            OR nickname LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/')
        </if>
    </sql>

    <insert id="insert" parameterType="com.example.erupt.repository.entity.User">
        INSERT INTO t_user (id, username, password, nickname, avatar, email, phone, status, remark,
                            create_by, update_by, create_time, update_time, del_flag)
        VALUES (#{id}, #{username}, #{password}, #{nickname}, #{avatar}, #{email}, #{phone}, #{status}, #{remark},
                #{createBy}, #{updateBy}, #{createTime}, #{updateTime}, #{delFlag})
    </insert>

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE id = #{id}
        AND del_flag = '0'
    </select>

    <!--
      按账号查询：命中生成列 username_active 上的唯一索引 uk_username_active。

      为什么不用 WHERE username = ? AND del_flag = '0'：实测该写法只能走 idx_del_flag
      （或干脆全表扫描），因为 username 本身没有独立索引——唯一约束是建在生成列上的。
      而 username_active 的定义就是 IF(del_flag='0', username, NULL)，所以
      WHERE username_active = ? 与「username 相同且未删除」语义完全等价，却能直接走
      type=const / rows=1 的唯一索引查询。

      这处在登录路径上（每次登录都要查一次），差别会随用户量放大。
    -->
    <select id="selectByUsername" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE username_active = #{username}
        LIMIT 1
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        <where>
            <include refid="Condition_Where"/>
        </where>
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM t_user
        <where>
            <include refid="Condition_Where"/>
        </where>
    </select>

    <!--
  只改密码：见 UserMapper#updatePasswordById 的说明。
  通用 updateById 不含 password 列，改密必须走这条独立语句。
-->
<update id="updatePasswordById">
    UPDATE t_user
    SET password    = #{password},
        update_time = #{updateTime}
    WHERE id = #{id}
      AND del_flag = '0'
</update>

    <update id="updateById" parameterType="com.example.erupt.repository.entity.User">
        UPDATE t_user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="lastLoginTime != null">last_login_time = #{lastLoginTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
        AND del_flag = '0'
    </update>

    <!--
      软删除：带 del_flag = '0' 前提，保证只把正常状态的记录改为已删除。
      不提供物理 DELETE，删除一律通过本语句完成。
    -->
    <update id="softDeleteById">
              UPDATE t_user
              SET del_flag = '1',
                  delete_by = #{deleteBy},
                  delete_time = #{deleteTime},
                  update_time = #{deleteTime}
              WHERE id = #{id}
              AND del_flag = '0'
          </update>

          <!--
            登录成功后刷新最近登录时间。
            只更新这一个字段：若改用 updateById 传入整个实体，
            会把查询时刻到保存时刻之间其他人修改过的字段覆盖回旧值。
            同样带 del_flag = '0' 前提，已删除账号不再刷新登录时间。
          -->
          <update id="updateLastLoginTime">
              UPDATE t_user
              SET last_login_time = #{lastLoginTime},
                  update_time = #{lastLoginTime}
              WHERE id = #{id}
              AND del_flag = '0'
          </update>
      </mapper>
