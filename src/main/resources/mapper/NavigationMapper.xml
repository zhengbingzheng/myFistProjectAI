<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erupt.repository.mapper.NavigationMapper">

    <resultMap id="BaseResultMap" type="com.example.erupt.repository.entity.Navigation">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="navigation_img" property="navigationImg" jdbcType="VARCHAR"/>
        <result column="navigation_name" property="navigationName" jdbcType="VARCHAR"/>
        <result column="navigation_url" property="navigationUrl" jdbcType="VARCHAR"/>
        <result column="cat" property="cat" jdbcType="VARCHAR"/>
        <!-- desc 为 MySQL 保留字，列名必须用反引号包裹 -->
        <result column="desc" property="description" jdbcType="VARCHAR"/>
        <result column="tag" property="tag" jdbcType="VARCHAR"/>
        <result column="create_user_id" property="createUserId" jdbcType="BIGINT"/>
        <result column="update_user_id" property="updateUserId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, navigation_img, navigation_name, navigation_url, cat, `desc`, tag,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <sql id="Condition_Where">
        <where>
            <if test="cat != null and cat != ''">
                AND cat = #{cat}
            </if>
            <if test="tag != null and tag != ''">
                AND tag = #{tag}
            </if>
            <!-- ESCAPE '/' 配合服务层 LikeEscape，避免用户输入的 %、_ 被当作通配符 -->
            <if test="keyword != null and keyword != ''">
                AND (navigation_name LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/'
                OR `desc` LIKE CONCAT('%', #{keyword}, '%') ESCAPE '/')
            </if>
        </where>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id"
            parameterType="com.example.erupt.repository.entity.Navigation">
        INSERT INTO t_navigation (navigation_img, navigation_name, navigation_url, cat, `desc`, tag, create_time,
                                  update_time)
        VALUES (#{navigationImg}, #{navigationName}, #{navigationUrl}, #{cat}, #{description}, #{tag}, #{createTime},
                #{updateTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_navigation
        WHERE id = #{id}
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_navigation
        <include refid="Condition_Where"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM t_navigation
        <include refid="Condition_Where"/>
    </select>

    <update id="updateById" parameterType="com.example.erupt.repository.entity.Navigation">
        UPDATE t_navigation
        <set>
            <if test="navigationName != null">navigation_name = #{navigationName},</if>
            <if test="navigationUrl != null">navigation_url = #{navigationUrl},</if>
            <if test="navigationImg != null">navigation_img = #{navigationImg},</if>
            <if test="cat != null">cat = #{cat},</if>
            <if test="description != null">`desc` = #{description},</if>
            <if test="tag != null">tag = #{tag},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM t_navigation
        WHERE id = #{id}
    </delete>

    <!-- 批量删除：ids 由服务层保证非空且已去重 -->
    <delete id="deleteByIds">
        DELETE FROM t_navigation
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countByIds" resultType="long">
        SELECT COUNT(*)
        FROM t_navigation
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 分类去重：SQL 层 DISTINCT + 剔除空值，应用层再做 trim 后二次去重 -->
    <select id="selectDistinctCats" resultType="java.lang.String">
        SELECT DISTINCT TRIM(cat) AS cat
        FROM t_navigation
        WHERE cat IS NOT NULL
          AND TRIM(cat) != ''
        ORDER BY cat
    </select>

    <!-- 分类全量：不去重，保持主键顺序 -->
    <select id="selectAllCats" resultType="java.lang.String">
        SELECT TRIM(cat) AS cat
        FROM t_navigation
        WHERE cat IS NOT NULL
          AND TRIM(cat) != ''
        ORDER BY id ASC
    </select>

    <select id="selectByCat" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_navigation
        WHERE cat = #{cat}
        ORDER BY id ASC
    </select>
</mapper>
